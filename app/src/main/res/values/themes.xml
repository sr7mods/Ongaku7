<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base splash screen theme using Android 12+ SplashScreen API -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#080910</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_ongaku_vector_emblem</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
